# ============================================
# REDEMPTION INTERNATIONAL SCHOOL — .HTACCESS
# Clean URLs & Rewrites Configuration
# ============================================

# Prevent mod_negotiation from interfering with mod_rewrite
Options -MultiViews

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# --------------------------------------------
# 0. FORCE HTTPS
# Redirect all HTTP requests to secure HTTPS
# --------------------------------------------
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --------------------------------------------
# 1. CANONICAL HOMEPAGE REDIRECT
# Redirect /index.html and /index to root /
# --------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# --------------------------------------------
# 2. STRIP TRAILING SLASH FROM NON-DIRECTORIES
# Prevents 404s when visitors type /page/
# --------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# --------------------------------------------
# 3. EXTERNAL REDIRECT: .html to CLEAN URL
# Redirects any incoming request for /page.html to /page
# --------------------------------------------
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --------------------------------------------
# 4. INTERNAL REWRITE: CLEAN URL to .html
# Resolves clean URLs (e.g. /admissions) to admissions.html internally
# --------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]